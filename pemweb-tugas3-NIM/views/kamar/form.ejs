// routes/kamar.js - hanya memetakan URL ke fungsi di controllers/kamarController.js
const express = require('express');
const c = require('../controllers/kamarController');
const { cekId } = require('../controllers/helpers');
const router = express.Router();
router.param('id', cekId('/kamar')); // tolak :id yang bukan angka

router.get('/', c.daftar);
router.get('/:id/detail', c.detail);
router.get('/tambah', c.formTambah);
router.post('/tambah', c.simpan);
router.get('/:id/edit', c.formEdit);
router.post('/:id/edit', c.perbarui);
router.post('/:id/hapus', c.hapus);

module.exports = router;
